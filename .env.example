# Docker Compose / VPS
HTTP_PORT=80
API_REPLICAS=2
WORKER_REPLICAS=2
POSTGRES_USER=aph
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=andhra_pickle_house

# API runtime
NODE_ENV=production
AUTH_PROVIDER=firebase
API_PORT=4000
WEB_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# Internal Docker networking
DATABASE_URL=postgresql://aph:replace-with-a-strong-postgres-password@postgres:5432/andhra_pickle_house?schema=public&connection_limit=20&pool_timeout=30
DIRECT_URL=postgresql://aph:replace-with-a-strong-postgres-password@postgres:5432/andhra_pickle_house?schema=public
REDIS_URL=redis://redis:6379
API_URL=http://api:4000
NEXT_PUBLIC_API_URL=http://api:4000

# Firebase Phone Auth (frontend public config)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAufAiaBSOhHgh0yBXZWKN5pWWEr7UjHLk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=andhra-pickle-house.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=andhra-pickle-house
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=andhra-pickle-house.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=51438309305
NEXT_PUBLIC_FIREBASE_APP_ID=1:51438309305:web:2120f6f9dd32b52d9b7068

# Firebase Admin (backend service account)
FIREBASE_PROJECT_ID=andhra-pickle-house
FIREBASE_CLIENT_EMAIL=replace-with-firebase-service-account-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# Auth
JWT_ACCESS_SECRET=replace-with-32-plus-character-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-character-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Legacy OTP provider, only used when AUTH_PROVIDER=legacy
OTP_PROVIDER=twilio
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=replace-with-twilio-messaging-service-sid
TWILIO_FROM_PHONE=
TWILIO_WHATSAPP_FROM=

# WhatsApp
WHATSAPP_BUSINESS_NUMBER=919876543210
WHATSAPP_ORDER_BASE_URL=https://wa.me

# Admin
ADMIN_PHONE=919876543210

# Cloudinary is required when NODE_ENV=production
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
CLOUDINARY_UPLOAD_FOLDER=andhra-pickle-house
CLOUDINARY_REQUIRED=true

# Worker / upload
QUEUE_WORKER_ENABLED=true
WORKER_CONCURRENCY=5
MAX_UPLOAD_MB=50
UPLOAD_DIR=./uploads
