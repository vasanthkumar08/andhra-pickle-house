# API production example. Do not commit real secrets.

NODE_ENV=production
AUTH_PROVIDER=legacy
API_PORT=4000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public
DIRECT_URL=postgresql://user:password@host:5432/database?schema=public

# Redis
REDIS_URL=rediss://default:password@host:6379

# Frontend / CORS
WEB_URL=https://your-web-domain.example
CORS_ORIGINS=https://your-web-domain.example
API_URL=https://your-api-domain.example

# JWT cookies/sessions
JWT_ACCESS_SECRET=replace-with-32-plus-character-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-character-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OTP / Twilio
OTP_PROVIDER=twilio
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=replace-with-twilio-messaging-service-sid
TWILIO_FROM_PHONE=
TWILIO_WHATSAPP_FROM=

# Business contact
WHATSAPP_BUSINESS_NUMBER=919876543210
ADMIN_PHONE=919876543210

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
CLOUDINARY_UPLOAD_FOLDER=andhra-pickle-house
CLOUDINARY_REQUIRED=true

# Worker / upload knobs
QUEUE_WORKER_ENABLED=false
WORKER_CONCURRENCY=5
MAX_UPLOAD_MB=50
UPLOAD_DIR=./uploads
