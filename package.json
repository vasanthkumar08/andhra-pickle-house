{
  "name": "andhra-pickle-house",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev:combined",
    "dev:frontend": "npm run dev -w @aph/web",
    "dev:backend": "npm run dev -w @aph/api",
    "dev:combined": "concurrently -n API,WEB -c green,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:split": "node scripts/dev-split.mjs",
    "dev:worker": "npm run worker:dev -w @aph/api",
    "clean:web": "node scripts/clean-web-cache.mjs",
    "infra:up": "node scripts/infra-up.mjs",
    "infra:down": "docker compose down",
    "lint": "npm run lint -w @aph/web --if-present",
    "build:shared": "npm run build --workspace=@aph/shared",
    "build:api": "npm run build --workspace=@aph/api",
    "build:web": "npm run build --workspace=@aph/web",
    "vercel-build": "npm run build:web",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build:shared && npm run build:web",
    "db:generate": "npm run db:generate -w @aph/api",
    "db:deploy": "npm run db:deploy -w @aph/api",
    "db:migrate": "npm run db:migrate -w @aph/api",
    "db:seed": "npm run db:seed -w @aph/api",
    "db:studio": "npm run db:studio -w @aph/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "lucide-react": "^1.16.0"
  }
}
